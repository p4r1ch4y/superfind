# Rust build output
/target/
**/target/

# Generated by scripts/build-jni.sh. Holds absolute NDK paths specific to
# whichever machine ran it, so it is never valid to commit.
/.cargo/config.toml

# Native libraries, built from crates/superfind-jni by scripts/build-jni.sh.
# Outputs, not sources: committing them would put megabytes of binary into every
# diff and let the .so drift silently from the Rust it claims to be. CI builds
# them; release artefacts carry them.
**/jniLibs/

# Note: Cargo.lock IS committed. This workspace produces shipped binaries, and a
# locked dependency set is what makes a release reproducible.

# Gradle
.gradle/
build/
# The wrapper jar is the exception — without it `./gradlew` cannot bootstrap.
!gradle/wrapper/gradle-wrapper.jar

# Android build output
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
captures/
.externalNativeBuild
.cxx

# Machine-specific: points at one particular SDK install.
local.properties

# Signing material. The key and its passwords never enter the repository.
*.jks
*.keystore
keystore.properties
*.p12
*.pepk

# Secrets
secrets/
*.key
*.pem
.env
.env.*

# IDE
.idea/
*.iml
.vscode/
.fleet/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Scratch from on-device testing
*.log
/screenshots-scratch/
