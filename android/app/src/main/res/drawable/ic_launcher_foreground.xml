<?xml version="1.0" encoding="utf-8"?>
<!--
  The radar from the hunt screen, reduced to a mark.

  Adaptive icons are masked to shapes the app does not choose — circle, squircle,
  teardrop — so everything meaningful sits inside the centre 66 of 108dp. The
  outer ring is deliberately just within that bound: a ring is the one shape a
  circular mask cannot spoil, and the wedge reads as "direction" even at 48dp,
  which is the size that actually matters in a launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring -->
    <path
        android:pathData="M25,54 a29,29 0 1,0 58,0 a29,29 0 1,0 -58,0"
        android:strokeColor="#4ADE80"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.45" />

    <!-- Middle ring -->
    <path
        android:pathData="M35,54 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0"
        android:strokeColor="#4ADE80"
        android:strokeWidth="2.5"
        android:strokeAlpha="0.7" />

    <!-- Sweep wedge, pointing up and to the right. -->
    <path
        android:pathData="M54,54 L68.5,28.9 A29,29 0 0,1 81.2,44.5 Z"
        android:fillColor="#4ADE80"
        android:fillAlpha="0.85" />

    <!-- The device itself -->
    <path
        android:pathData="M47.5,54 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0"
        android:fillColor="#4ADE80" />
</vector>
