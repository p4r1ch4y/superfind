<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bluetooth, pre-Android 12. maxSdkVersion matters: without it these are
         requested forever and look alarming in the store listing. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Android 6 to 11 tie BLE scanning to location: without a location
         permission the scan silently returns zero results rather than failing,
         which is the single most common way a BLE app appears broken. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Android 12+. neverForLocation lets us keep scanning without ever asking
         for location, which is both honest and a much easier prompt to accept:
         we genuinely do not want the user's whereabouts, only signal strength. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />

    <!-- Android 13+, for Wi-Fi RTT ranging where the hardware supports it. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Android 16's unified ranging permission, covering UWB, Channel
         Sounding and Wi-Fi NAN RTT together. -->
    <uses-permission android:name="android.permission.RANGING" />

    <!-- Haptic proximity feedback. A normal permission: granted at install
         with no prompt, but absent it vibrate() throws and the buzz would
         silently never happen. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Step detection for dead reckoning. Only needed from Android 10. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"
        tools:targetApi="q" />

    <!-- Every radio is optional: the app degrades to a working tier without
         each of them, and required="false" keeps it installable on devices
         that lack them. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.uwb" android:required="false" />
    <uses-feature android:name="android.hardware.wifi.rtt" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Superfind">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
